# Reference only: Reading Room does not automatically source this file.
# No environment variables are required for local-only use.

# Optional library override (use an absolute path outside the checkout).
# LIBRARY_ROOT=/absolute/path/to/books

# Optional private credential file; preferred for a login service.
# LIBRARY_OPENAI_ENV=/absolute/private/path/reading-room.env

# Put the actual key in that private file, not here or in frontend variables.
# A key alone does not enable semantic search or metadata review.
# OPENAI_API_KEY=replace-with-your-own-key
