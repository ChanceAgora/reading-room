#!/bin/sh
set -eu
READING_ROOM_CHECKOUT=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd)
if ! command -v python3.12 >/dev/null 2>&1; then
  echo 'Python 3.12 is required. Install it from https://www.python.org/downloads/macos/ or your package manager, then run ./bin/setup again.' >&2
  exit 1
fi
exec python3.12 "$READING_ROOM_CHECKOUT/scripts/setup.py" "$@"
